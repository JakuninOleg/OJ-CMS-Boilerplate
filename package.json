{
  "name": "oj-cms-boilerplate", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint src scripts next.config.mjs",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx --test tests/unit.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx tests/integration.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0", "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2", "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2", "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/ui": "3.90.2", "@payloadcms/translations": "3.90.2",
    "graphql": "16.11.0", "next": "16.3.8", "payload": "3.90.2", "nodemailer": "10.0.16",
    "react": "19.3.0", "react-dom": "19.3.0", "sass": "1.105.1", "sharp": "0.35.5"
  },
  "overrides": { "undici": "7.29.1", "dompurify": "3.4.16", "nodemailer": "10.0.16", "sass": "1.105.1", "esbuild": "0.28.2" },
  "devDependencies": {
    "@eslint/js": "10.0.1", "@types/node": "^24.0.0", "@types/nodemailer": "8.0.2", "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0", "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0", "tsx": "4.23.15", "typescript": "5.8.3"
  }
}
