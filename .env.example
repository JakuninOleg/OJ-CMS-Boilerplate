# Use a NEW database and credentials for every project. No production credentials here.
DATABASE_URL=postgresql://oj:local-development-only@127.0.0.1:5432/oj_cms
PAYLOAD_SECRET=
PUBLIC_SITE_URL=http://127.0.0.1:3200
# Optional PEM certificate for managed PostgreSQL (literal \n is supported)
DATABASE_CA_CERT=
# For one-time CLI admin creation. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional S3. Without these, uploads use .data/media (persistent disk required).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media
# Optional email for password recovery. Sender must be verified by your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=OJ CMS
